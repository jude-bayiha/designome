{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designome.dev/schemas/audit-plan/1.0.0",
  "title": "Designome normalized audit plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditContractVersion",
    "createdAt",
    "projectRoot",
    "configPath",
    "outputDirectory",
    "baseUrl",
    "provider",
    "config",
    "installation",
    "routes",
    "perceptual",
    "captureAdapter",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "auditContractVersion": { "enum": ["1.0.0", "2.0.0"] },
    "designDnaFingerprint": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "projectRoot": { "type": "string", "minLength": 1 },
    "configPath": { "type": "string", "minLength": 1 },
    "outputDirectory": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "startCommand": { "type": ["string", "null"] },
    "focus": { "type": ["object", "null"] },
    "provider": { "type": "object" },
    "config": { "type": "object" },
    "installation": { "type": "object" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "verification": { "$ref": "#/$defs/verification" },
    "perceptual": { "type": "object" },
    "captureAdapter": { "type": "object" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "required": ["auditContractVersion"],
        "properties": { "auditContractVersion": { "const": "2.0.0" } }
      },
      "then": {
        "required": ["designDnaFingerprint", "verification"]
      }
    }
  ],
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "id",
        "path",
        "viewports",
        "flows",
        "scenarios",
        "directions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "viewports": { "type": "array", "minItems": 1 },
        "flows": { "type": "array" },
        "scenarios": { "type": "array", "minItems": 1 },
        "directions": { "type": "array", "minItems": 1 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeId", "viewport", "scenario", "direction"],
      "properties": {
        "routeId": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 1 },
            "height": { "type": "number", "minimum": 1 }
          }
        },
        "scenario": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["ltr", "rtl"] }
      }
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "artifactRef",
        "claimPath",
        "statement",
        "epistemicStatus",
        "priority",
        "exceptions",
        "evidenceRefs",
        "uiDomainRefs",
        "layer",
        "method",
        "disposition"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "artifactRef": { "type": "string", "minLength": 1 },
        "claimPath": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "epistemicStatus": {
          "enum": ["observed", "inferred", "proposed", "unknown"]
        },
        "confidence": { "type": ["object", "null"] },
        "priority": { "enum": ["critical", "important", "supporting"] },
        "exceptions": { "type": "array" },
        "evidenceRefs": { "type": "array" },
        "uiDomainRefs": { "type": "array" },
        "layer": { "enum": ["mechanical", "perceptual", "usage"] },
        "method": {
          "enum": ["measurement", "perceptual", "interaction", "accessibility"]
        },
        "disposition": {
          "enum": ["requirement", "calibration", "excluded", "diagnostic"]
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "obligationRef",
        "layer",
        "method",
        "targetContexts",
        "sourceRefs",
        "excludedContexts",
        "implementationRefs"
      ],
      "properties": {
        "obligationRef": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["mechanical", "perceptual", "usage"] },
        "method": {
          "enum": ["measurement", "perceptual", "interaction", "accessibility"]
        },
        "targetContexts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/context" }
        },
        "sourceRefs": { "type": "array" },
        "excludedContexts": { "type": "array" },
        "implementationRefs": { "type": "array" }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "obligationRef",
        "layer",
        "method",
        "targetContexts",
        "sourceRefs",
        "implementationRefs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "obligationRef": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["mechanical", "perceptual", "usage"] },
        "method": {
          "enum": ["measurement", "perceptual", "interaction", "accessibility"]
        },
        "targetContexts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/context" }
        },
        "sourceRefs": { "type": "array" },
        "implementationRefs": { "type": "array" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditContractVersion",
        "dnaFingerprint",
        "obligations",
        "bindings",
        "checks",
        "exclusions",
        "unresolved"
      ],
      "properties": {
        "auditContractVersion": { "const": "2.0.0" },
        "dnaFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "obligations": {
          "type": "array",
          "items": { "$ref": "#/$defs/obligation" }
        },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "exclusions": { "type": "array" },
        "unresolved": { "type": "array" }
      }
    }
  }
}
