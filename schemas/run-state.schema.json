{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designome.dev/schemas/run-state/1.0.0",
  "title": "Designome persistent orchestrated workflow state",
  "type": "object",
  "required": [
    "schemaVersion",
    "workflowId",
    "revision",
    "owner",
    "status",
    "currentStep",
    "runDirectory",
    "projectPath",
    "sourcePaths",
    "dnaPath",
    "steps"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workflowId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "owner": { "const": "designome" },
    "status": {
      "enum": [
        "running",
        "awaiting-human",
        "awaiting-host",
        "failed",
        "completed"
      ]
    },
    "currentStep": { "type": "string", "minLength": 1 },
    "runDirectory": { "type": "string", "minLength": 1 },
    "projectPath": { "type": "string", "minLength": 1 },
    "sourcePaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "dnaPath": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "owner", "status", "attempts", "artifacts"],
        "properties": {
          "id": { "type": "string" },
          "owner": { "enum": ["designome-runtime", "host-agent", "human"] },
          "status": {
            "enum": [
              "pending",
              "in-progress",
              "awaiting",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "attempts": { "type": "integer", "minimum": 0 },
          "artifacts": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
