{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designome.dev/schemas/audit-config.schema.json",
  "title": "Designome audit configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseUrl", "routes"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "baseUrl": { "type": "string", "format": "uri" },
    "startCommand": { "type": "string", "minLength": 1 },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 240 },
        "height": { "type": "integer", "minimum": 240 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "viewports", "flows"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "path": { "type": "string", "pattern": "^/" },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/viewport" }
        },
        "flows": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
